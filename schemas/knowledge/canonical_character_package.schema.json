{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crismag/biblegamecard/schemas/knowledge/canonical_character_package.schema.json",
  "title": "BibleGameCard Canonical Character Knowledge Package",
  "description": "Schema for an assembled normalized character package. Cross-document graph integrity is enforced by tools/validate_character_knowledge.rb.",
  "type": "object",
  "required": ["manifest", "character", "references", "timeline", "relationships", "symbols", "gameplay", "art", "prompt", "review", "version_history"],
  "properties": {
    "manifest": {"$ref": "#/$defs/manifest"},
    "character": {"$ref": "#/$defs/character"},
    "references": {"$ref": "#/$defs/references_document"},
    "timeline": {"$ref": "#/$defs/timeline_document"},
    "relationships": {"$ref": "#/$defs/relationships_document"},
    "symbols": {"$ref": "#/$defs/symbols_document"},
    "gameplay": {"$ref": "#/$defs/profile_document"},
    "art": {"$ref": "#/$defs/profile_document"},
    "prompt": {"$ref": "#/$defs/profile_document"},
    "review": {"$ref": "#/$defs/review_document"},
    "version_history": {"$ref": "#/$defs/version_history_document"}
  },
  "additionalProperties": false,
  "$defs": {
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "entity_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "reference_id": {"type": "string", "pattern": "^REF_[A-Z0-9_]+$"},
    "event_id": {"type": "string", "pattern": "^EVT_[A-Z0-9_]+$"},
    "location_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "symbol_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "state": {"enum": ["draft", "prototype", "review_requested", "changes_requested", "validated", "theology_approved", "gameplay_approved", "art_direction_approved", "prompt_approved", "art_approved", "card_approved", "production_approved", "blocked", "released", "deprecated"]},
    "manifest": {
      "type": "object",
      "required": ["schema_version", "package_id", "character_id", "collector_id", "package_version", "knowledge_version", "master_schema", "documents", "registries", "human_views"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/semver"},
        "package_id": {"$ref": "#/$defs/entity_id"},
        "character_id": {"$ref": "#/$defs/entity_id"},
        "collector_id": {"type": "string", "pattern": "^[A-Z][0-9]{3}$"},
        "package_version": {"$ref": "#/$defs/semver"},
        "knowledge_version": {"$ref": "#/$defs/semver"},
        "master_schema": {"type": "string"},
        "documents": {"type": "object", "required": ["character", "references", "timeline", "relationships", "symbols", "gameplay", "art", "prompt", "review", "version_history"]},
        "registries": {"type": "object", "required": ["entities", "locations", "symbols"]},
        "human_views": {"type": "object", "required": ["root", "authority", "edit_policy", "projections"]},
        "consumers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "character": {
      "type": "object",
      "required": ["schema_version", "character_id", "metadata", "identity", "names", "titles", "leadership", "virtues", "failures_and_limits", "lifespan", "location_ids", "summary", "classification_policy"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/semver"},
        "character_id": {"$ref": "#/$defs/entity_id"},
        "metadata": {"type": "object", "required": ["collector_id", "slug", "rarity", "set_id", "package_version", "knowledge_version", "canonical_status"]},
        "identity": {"type": "object", "required": ["entity_id", "testament", "nation_entity_id", "historical_period_tags", "role_tags"]},
        "names": {"type": "object", "required": ["primary", "aliases"]},
        "titles": {"type": "object", "required": ["project_title", "scriptural_descriptors"]},
        "leadership": {"type": "object", "required": ["predecessor_entity_id", "named_successor_entity_id", "calling", "calling_reference_ids", "authority_model"]},
        "virtues": {"type": "array", "items": {"$ref": "#/$defs/claim"}, "uniqueItems": true},
        "failures_and_limits": {"type": "array", "items": {"$ref": "#/$defs/claim"}, "uniqueItems": true},
        "lifespan": {"type": "object", "required": ["death_age_years", "death_age_reference_ids", "burial_location_id", "absolute_dates", "chronology_note"]},
        "location_ids": {"type": "array", "items": {"$ref": "#/$defs/location_id"}, "uniqueItems": true},
        "summary": {"type": "object", "required": ["defining_contribution", "canonical_summary"]},
        "classification_policy": {"type": "object"}
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["id", "reference_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/entity_id"},
        "label": {"type": "string"},
        "classification": {"type": "string"},
        "summary": {"type": "string"},
        "reference_ids": {"type": "array", "items": {"$ref": "#/$defs/reference_id"}, "minItems": 1, "uniqueItems": true}
      }
    },
    "reference_segment": {
      "type": "object",
      "required": ["chapter", "verse_start", "verse_end"],
      "properties": {
        "chapter": {"type": "integer", "minimum": 1},
        "verse_start": {"type": "integer", "minimum": 1},
        "verse_end": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "scripture_reference": {
      "type": "object",
      "required": ["id", "testament", "book", "segments", "context", "importance"],
      "properties": {
        "id": {"$ref": "#/$defs/reference_id"},
        "testament": {"enum": ["old", "new"]},
        "book": {"type": "string", "minLength": 1},
        "segments": {"type": "array", "items": {"$ref": "#/$defs/reference_segment"}, "minItems": 1},
        "context": {"type": "string", "minLength": 1},
        "importance": {"enum": ["primary", "supporting"]}
      },
      "additionalProperties": false
    },
    "references_document": {
      "type": "object",
      "required": ["schema_version", "character_id", "references"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/semver"},
        "character_id": {"$ref": "#/$defs/entity_id"},
        "references": {"type": "array", "items": {"$ref": "#/$defs/scripture_reference"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["event_id", "sequence", "title", "reference_ids", "participant_entity_ids", "location_ids", "summary", "importance"],
      "properties": {
        "event_id": {"$ref": "#/$defs/event_id"},
        "sequence": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "reference_ids": {"type": "array", "items": {"$ref": "#/$defs/reference_id"}, "minItems": 1, "uniqueItems": true},
        "participant_entity_ids": {"type": "array", "items": {"$ref": "#/$defs/entity_id"}, "minItems": 1, "uniqueItems": true},
        "location_ids": {"type": "array", "items": {"$ref": "#/$defs/location_id"}, "minItems": 1, "uniqueItems": true},
        "summary": {"type": "string", "minLength": 1},
        "importance": {"enum": ["supporting", "formative", "primary", "defining"]}
      },
      "additionalProperties": false
    },
    "timeline_document": {
      "type": "object",
      "required": ["schema_version", "character_id", "ordering", "absolute_dates_status", "events"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/semver"},
        "character_id": {"$ref": "#/$defs/entity_id"},
        "ordering": {"enum": ["canonical_narrative"]},
        "absolute_dates_status": {"enum": ["known", "approximate", "disputed", "intentionally_unresolved"]},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": ["id", "target_entity_id", "relationship_types", "direction", "importance", "influence", "reference_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^REL_[A-Z0-9_]+$"},
        "target_entity_id": {"$ref": "#/$defs/entity_id"},
        "relationship_types": {"type": "array", "items": {"$ref": "#/$defs/entity_id"}, "minItems": 1, "uniqueItems": true},
        "direction": {"enum": ["outgoing", "incoming", "bidirectional"]},
        "importance": {"enum": ["primary", "supporting"]},
        "influence": {"type": "string", "minLength": 1},
        "reference_ids": {"type": "array", "items": {"$ref": "#/$defs/reference_id"}, "minItems": 1, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "relationships_document": {
      "type": "object",
      "required": ["schema_version", "character_id", "relationships"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/semver"},
        "character_id": {"$ref": "#/$defs/entity_id"},
        "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "symbols_document": {
      "type": "object",
      "required": ["schema_version", "character_id", "symbol_uses", "prohibited_visual_concepts"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/semver"},
        "character_id": {"$ref": "#/$defs/entity_id"},
        "symbol_uses": {"type": "array", "items": {"type": "object", "required": ["symbol_id", "usage", "scene_constraints", "reference_ids"]}, "minItems": 1},
        "prohibited_visual_concepts": {"type": "array", "items": {"type": "object", "required": ["id", "reason", "source"]}}
      },
      "additionalProperties": false
    },
    "profile_document": {
      "type": "object",
      "required": ["schema_version", "character_id", "profile_version"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/semver"},
        "character_id": {"$ref": "#/$defs/entity_id"},
        "profile_version": {"$ref": "#/$defs/semver"}
      },
      "additionalProperties": true
    },
    "review_document": {
      "type": "object",
      "required": ["schema_version", "character_id", "review_state", "generation_state", "required_review_roles"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/semver"},
        "character_id": {"$ref": "#/$defs/entity_id"},
        "review_state": {"type": "object", "additionalProperties": {"$ref": "#/$defs/state"}},
        "generation_state": {"type": "object", "required": ["state", "generation_request_path", "blocking_reasons"]},
        "required_review_roles": {"type": "array", "items": {"$ref": "#/$defs/entity_id"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "version_history_document": {
      "type": "object",
      "required": ["schema_version", "character_id", "versions"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/semver"},
        "character_id": {"$ref": "#/$defs/entity_id"},
        "versions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["version", "date", "scope", "author", "reason", "changes", "review_state"]}}
      },
      "additionalProperties": false
    }
  }
}
