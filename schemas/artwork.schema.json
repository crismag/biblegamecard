{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crismag/biblegamecard/schemas/artwork.schema.json",
  "title": "Bible Game Card Artwork Specification",
  "type": "object",
  "required": ["collector_id", "subject", "composition", "visual_identity", "symbols", "status"],
  "properties": {
    "collector_id": {"type": "string", "pattern": "^[A-Z][0-9]{3}$"},
    "subject": {"type": "object"},
    "composition": {"type": "object"},
    "visual_identity": {"type": "object"},
    "symbols": {"type": "array", "items": {"type": "object"}},
    "avoid": {"type": "array", "items": {"type": "string"}},
    "reference_notes": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["draft", "review", "approved", "superseded"]}
  },
  "additionalProperties": true
}
